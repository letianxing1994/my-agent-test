# ──────────────── Server ────────────────
A2A_PORT=8080
A2A_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ──────────────── Kafka ────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=my-agent-test
KAFKA_GROUP_ID=workflow-consumer
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
WORKFLOW_TASK_TOPIC=workflow-tasks
WORKFLOW_RESULT_TOPIC=workflow-results
AGENT_EVENT_TOPIC=agent-events

# ──────────────── Databases / Cache ────────────────
MYSQL_URL=mysql://user:password@localhost:3306/a2a_game_factory
REDIS_URL=redis://localhost:6379/0

# ──────────────── Object Storage (Aliyun OSS) ────────────────
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your-oss-ak
OSS_ACCESS_KEY_SECRET=your-oss-sk
OSS_BUCKET=your-oss-bucket
OSS_INTERNAL=false

# ──────────────── Google Cloud Storage ────────────────
GCP_PROJECT_ID=your-gcp-project
GCS_BUCKET=your-gcs-bucket
GCS_CREDENTIALS_JSON={"client_email":"...", "private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# ──────────────── LLM / Agent Defaults ────────────────
OPENAI_API_KEY=
PLANNING_MODEL=openai:gpt-4o-mini
ART_MODEL=qwen-vl-max
MUSIC_MODEL=qwen-music
TECH_MODEL=openai:gpt-4.1-mini
QA_MODEL=openai:gpt-4o-mini

# ──────────────── Instruction / Preview ────────────────
PREVIEW_TIMEOUT_MS=120000
CLARIFICATION_SSE_RETRY_MS=5000

# ──────────────── Knowledge & Mem0 ────────────────
MEM0_ENDPOINT=http://localhost:7000/api/memories
MEM0_API_KEY=mem0-demo-key
KNOWLEDGE_BASE_DIR=./data/knowledge-base

# ──────────────── Callbacks (Optional) ────────────────
CALLBACK_DEFAULT_WEBHOOK=
CALLBACK_DEFAULT_EVENTS=sse

